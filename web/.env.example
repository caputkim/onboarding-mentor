# 멘토·운영 서비스 (mentor/web). 신입 서비스와 같은 DB 를 쓴다. 로컬 포트 3001.
DATABASE_URL="postgresql://onboard:onboard@localhost:5433/onboard?schema=public"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
AUTH_SECRET=""                       # openssl rand -base64 32
AUTH_URL="http://localhost:3001"
ALLOWED_EMAIL_DOMAIN="nxtcloud.kr"
SEED_ADMIN_EMAIL=""                  # npm run db:seed 가 운영자로 만든다 (비밀번호는 가입 화면에서)
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""
INGEST_TOKEN=""                      # ingest/ingest.py 가 쓰는 Bearer 토큰 (openssl rand -hex 24)
CRON_TOKEN=""                        # /api/admin/cron/weekly-summary 호출용 Bearer 토큰
NEWCOMER_APP_URL="http://localhost:3000"   # 구성원이 이 서비스에 들어왔을 때 안내할 신입 서비스 주소
# PLANS_DIR=/app/plans                # 콘솔 플랜 가져오기가 읽는 폴더. 기본은 ../plans
